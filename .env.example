# Copy this file to .env.local for local development and fill in real values.
# Never commit .env.local or any file containing real secrets.

# --- Firebase web app config (safe to expose to the browser) ---
# Firebase Console > Project Settings > General > Your apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Firebase Admin SDK (server-only, never exposed to the browser) ---
# Local dev: download a service-account key from Firebase Console >
# Project Settings > Service Accounts > Generate new private key, save it
# OUTSIDE the repo (e.g. ../cml-service-account.json) and point this at it.
GOOGLE_APPLICATION_CREDENTIALS=

# Vercel (or anywhere you can't easily ship a file to disk): base64-encode
# the same service-account JSON and paste it here instead.
#   powershell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.json"))
#   bash:       base64 -w0 key.json
FIREBASE_SERVICE_ACCOUNT_BASE64=
