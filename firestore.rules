rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
//
// Identity model: every signed-in user (admin / teacher / student) is a real
// Firebase Auth user, and every non-admin write path that matters (grading,
// team creation from a registration) happens server-side through the Admin
// SDK, which bypasses these rules entirely. These rules exist to stop a
// browser from reading/writing anything it shouldn't via the client SDK —
// they are the actual security boundary, not the app's UI.
//
// Custom claims set server-side (see lib/server/auth.ts):
//   admin:   { role: "admin" }
//   teacher: { role: "teacher", schoolId }
//   student: { role: "student", schoolId, teamId, memberId, groupId }

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    function isTeacherOf(schoolId) {
      return isSignedIn()
        && request.auth.token.role == 'teacher'
        && request.auth.token.schoolId == schoolId;
    }

    function isStudentOf(schoolId) {
      return isSignedIn()
        && request.auth.token.role == 'student'
        && request.auth.token.schoolId == schoolId;
    }

    function isTeamMember(teamId) {
      return isSignedIn()
        && request.auth.token.role == 'student'
        && request.auth.token.teamId == teamId;
    }

    function isInGroup(groupId) {
      return isSignedIn()
        && request.auth.token.role == 'student'
        && request.auth.token.groupId == groupId;
    }

    // ---- Public registration form ---------------------------------------
    // Anyone can submit a registration. Nobody but admin can read/edit one
    // back — the app never needs to read a registration from the client
    // after submitting it, and approval/team-creation happens server-side.
    match /registrations/{registrationId} {
      allow create: if request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin();
    }

    // ---- Schools / teams / members ---------------------------------------
    match /schools/{schoolId} {
      allow read: if isAdmin() || isTeacherOf(schoolId) || isStudentOf(schoolId);
      allow write: if isAdmin();

      match /teams/{teamId} {
        allow read: if isAdmin() || isTeacherOf(schoolId) || isTeamMember(teamId);
        // Teachers may edit their own roster (names/emails), but not
        // reassign conference/groupId — that's an admin/bracketing decision.
        allow update: if isAdmin() || (
          isTeacherOf(schoolId) &&
          request.resource.data.conference == resource.data.conference &&
          request.resource.data.groupId == resource.data.groupId
        );
        allow create, delete: if isAdmin();

        match /members/{memberId} {
          allow read: if isAdmin() || isTeacherOf(schoolId) || isTeamMember(teamId);
          allow write: if isAdmin() || isTeacherOf(schoolId);
        }
      }
    }

    // ---- Group-stage brackets ---------------------------------------------
    match /groups/{groupId} {
      // Static metadata is safe for any signed-in competitor to read.
      allow read: if isAdmin() || isInGroup(groupId);
      allow write: if isAdmin();

      // Presence only — visible to the whole group, writable only by the
      // team it belongs to (or the server).
      match /teamState/{teamId} {
        allow read: if isAdmin() || isInGroup(groupId);
        allow write: if isAdmin() || isTeamMember(teamId);

        // Answers for a specific round: private to the owning team.
        match /private/{roundId} {
          allow read, write: if isAdmin() || isTeamMember(teamId);
        }
      }
    }

    // ---- Scores -------------------------------------------------------
    // Written exclusively by server routes via the Admin SDK. The client
    // may read its own scores but can never write or fabricate one.
    match /scores/{scoreId} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        (resource.data.memberId == request.auth.token.memberId ||
         resource.data.teamId == request.auth.token.teamId)
      );
      allow write: if false;
    }

    // ---- Live competition schedule ----------------------------------------
    // Every round timer in the app reads this instead of hardcoding dates.
    match /config/schedule {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
